# Copy to .env and fill in. Never commit .env.

# Gemini (script, storyboard, TTS)
GEMINI_API_KEY=
# Prefer lite models when Flash is overloaded (503)
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_MODEL_FALLBACKS=gemini-3.5-flash-lite,gemini-3.1-flash-lite,gemini-3.6-flash,gemini-3.8-flash
GEMINI_TTS_MODEL=gemini-3.8-flash-lite-tts
GEMINI_TTS_FALLBACKS=gemini-3.8-flash-lite-tts,gemini-3.8-flash-tts

# Cloudflare Workers AI (FLUX keyframes)
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
# Optional model override, e.g. @cf/black-forest-labs/flux-1-schnell
IMAGE_MODEL=@cf/black-forest-labs/flux-1-schnell

# Backends: wan | hunyuan | kenburns
SHOT_BACKEND=kenburns
# flux
IMAGE_BACKEND=flux
# gemini
TTS_BACKEND=gemini
MUSIC_BACKEND=acestep

# Web / worker
WORKER_SECRET=change-me
REDIS_URL=
BLOB_READ_WRITE_TOKEN=
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Paths
OUTPUT_DIR=outputs
RUNS_LOG=runs.jsonl
