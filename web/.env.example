# Copy to web/.env.local for local dev.
# On Vercel: Project → Settings → Environment Variables (Production + Preview).
#
# Gemini / Cloudflare keys do NOT go here — they belong on the Python worker host
# (Railway/Render root .env).

# Local:
WORKER_URL=http://127.0.0.1:8080
# Production example:
# WORKER_URL=https://your-worker.up.railway.app

WORKER_SECRET=change-me
